# PostgreSQL (application-dev.yaml과 동일한 변수명)
DB_URL=jdbc:postgresql://localhost:5432/coala_web
DB_USERNAME=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# CORS
APP_CORS_ALLOWED_ORIGINS=https://example.com

# Swagger
SWAGGER_ENABLED=false

# Redis
REDIS_URL=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
